# Written by `neon deploy`
# Pooled connection, owner role
DATABASE_URL=
# Direct connection, owner role. Used by drizzle-kit and pgTAP tests
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# App secret for cached session cookies, not managed by Neon: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Pooled connection as authenticated_backend, the role the app runs as. RLS applies to it.
# Not managed by Neon: set the role password outside migrations, see README
DATABASE_AUTHENTICATED_URL=

# Integration tests (pnpm test:integration) read .env.integration instead: the same two
# variables, pointing at the Neon branch `integration-tests`. Never use production here.
# DATABASE_AUTHENTICATED_URL=
# DATABASE_URL_UNPOOLED=
